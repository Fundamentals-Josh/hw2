mystery=function(DF,positionsToUse,CountryColumn='Country'){# This defines a function named mystery that takes three arguments: DF The input data frame. positionsToUse: A vector of column indices or names from DF for which you want to calculate the average. CountryColumn: The name of the column in DF that contains country information (defaults to 'Country').
newDF=DF[,c(CountryColumn),drop = FALSE]
average='average'
newDF[,average]=apply(DF[,positionsToUse],1,mean,na.rm = TRUE)
return(newDF[,c(CountryColumn,average)])
}
mystery=function(DF,positionsToUse,CountryColumn='Country'){# This defines a function named mystery that takes three arguments: DF The input data frame. positionsToUse: A vector of column indices or names from DF for which you want to calculate the average. CountryColumn: The name of the column in DF that contains country information (defaults to 'Country').
newDF=DF[,c(CountryColumn),drop = FALSE] #It creates a new data frame called newDF containing only the CountryColumn from the original DF
average='average' #defines a string 'average' to be used as the name for the new column that will store the calculated averages.
newDF[,average]=apply(DF[,positionsToUse],1,mean,na.rm = TRUE)#creates a new data frame called newDF containing only the CountryColumn from the original DF
return(newDF[,c(CountryColumn,average)]) #the function returns the newDF data frame, but it explicitly selects only the CountryColumn and the newly created 'average' column to be part of the output.
}
