theOnesOK(fragility23[,c('Country','S1: Demographic Pressures')]) #this function is establishing conditions to label the variables.  If the the data point is above the average value, we are asking R to assign a category of above average.  For all other values, we are assigning a category of below/at average.
mystery=function(DF,positionsToUse,CountryColumn='Country'){
newDF=DF[,c(CountryColumn),drop = FALSE]
average='average'
newDF[,average]=apply(DF[,positionsToUse],1,mean,na.rm = TRUE)
return(newDF[,c(CountryColumn,average)])
}
theOnesOK = function(DF_country_and_variable) { #This defines a function named theOnesOK that accepts one argument: DF_country_and_variable, which is expected to be a data frame.
variable_values <- DF_country_and_variable[,2]#It extracts all values from the second column of the input data frame and stores them in a vector named variable_values. This assumes the second column contains the numerical data you want to analyze.
avg_value <- mean(variable_values, na.rm = TRUE) #It calculates the mean (average) of the variable_values vector. na.rm = TRUE ensures that any missing values (NA) are ignored during the mean calculation.
is_above <- ifelse(variable_values > avg_value, "Above Average", "Below/At Average") #This line creates a new vector called is_above. For each value in variable_values, it checks if that value is greater than the calculated avg_value. If it is, the corresponding element in is_above becomes "Above Average"; otherwise, it becomes "Below/At Average".
DF_country_and_variable$Status <- is_above #It adds a new column named Status to the original input data frame DF_country_and_variable and populates it with the values from the is_above vector.
return(DF_country_and_variable) #Finally, the function returns the modified data frame, which now includes the new Status column.
}
theOnesOK(fragility23[,c('Country','S1: Demographic Pressures')]) #This takes the previously constructed command and applies it to the defined columns of the data frame.
theOnesOK2 = function(DF, DFvariable, CountryColumn='Country') {
variable_values <- DF[,DFvariable]
avg_value <- mean(variable_values, na.rm = TRUE)
is_above <- ifelse(variable_values > avg_value, "Above Average", "Below/At Average")
newname = paste('Status_on', DFvariable)
DF[,newname] <- is_above
return(DF[,c(CountryColumn, newname)])
}
theOnesOK2(fragility23[,c('Country','S1: Demographic Pressures')])
